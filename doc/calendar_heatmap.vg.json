{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 180,
  "title": "Daily Distribution of Disaster Events",
  "data": {
    "url": "data/ExtremeWeather_2.csv"
  },
  "transform": [
    {
      "calculate": "toDate(datum['Date/Time'])",
      "as": "eventDate"
    },
    {
      "filter": "isValid(datum.eventDate)"
    },
    {
      "calculate": "year(datum.eventDate)",
      "as": "year"
    },
    {
      "calculate": "week(datum.eventDate)",
      "as": "week"
    },
    {
      "calculate": "day(datum.eventDate)",
      "as": "weekday"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "events"
        }
      ],
      "groupby": ["year", "week", "weekday"]
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "week",
      "type": "ordinal",
      "title": "Week of year",
      "axis": {
        "labelAngle": 0,
        "tickCount": 12
      }
    },
    "y": {
      "field": "weekday",
      "type": "ordinal",
      "sort": [1, 2, 3, 4, 5, 6, 0],
      "title": "Day of week",
      "axis": {
        "labelExpr": "datum.value === 0 ? 'Sun' : datum.value === 1 ? 'Mon' : datum.value === 2 ? 'Tue' : datum.value === 3 ? 'Wed' : datum.value === 4 ? 'Thu' : datum.value === 5 ? 'Fri' : 'Sat'"
      }
    },
    "color": {
      "field": "events",
      "type": "quantitative",
      "title": "Event count",
      "scale": {
        "scheme": "orangered"
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "week",
        "type": "ordinal",
        "title": "Week"
      },
      {
        "field": "weekday",
        "type": "ordinal",
        "title": "Day index"
      },
      {
        "field": "events",
        "type": "quantitative",
        "title": "Events"
      }
    ]
  }
}